rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Anyone signed in can view profile photos (they're shown to other
    // users in chats/People list), but a user can only upload/replace
    // their own.
    match /profilePhotos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Photos/videos shared inside a 1:1 chat. The chatId is a hash of the
    // two participants' uids (see directChatId in src/lib/chat.ts) so it
    // isn't guessable, and only signed-in users can read/write here.
    match /chatMedia/{chatId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*') || request.resource.contentType.matches('audio/.*'));
    }
  }
}
