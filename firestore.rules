rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Any signed-in user can read the directory (to find people to chat
    // with) but can only write their own profile document.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // A chat can only be read/written by its two participants.
    match /chats/{chatId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow delete: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Calls (WebRTC signaling) — only the caller/callee involved may read or
    // write the offer/answer/candidates for their call.
    match /calls/{callId} {
      allow read, update: if isSignedIn()
        && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.callerId;

      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
