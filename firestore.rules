rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Any signed-in user can read the directory (to find people to chat
    // with) but can only write their own profile document.
    match /users/{userId} {
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function safeIncomingUpdate() {
        return changedKeys().hasOnly(["incomingRequests"]);
      }

      function safeOutgoingUpdate() {
        return changedKeys().hasOnly(["outgoingRequests"]);
      }

      function safeOutgoingAccept() {
        return changedKeys().hasOnly(["outgoingRequests", "friends"])
          && resource.data.outgoingRequests.size() == request.resource.data.outgoingRequests.size() + 1
          && request.resource.data.friends.size() == resource.data.friends.size() + 1
          && request.auth.uid in request.resource.data.friends;
      }

      function safeFriendRemove() {
        return changedKeys().hasOnly(["friends"])
          && resource.data.friends.hasAll(request.resource.data.friends)
          && resource.data.friends.size() == request.resource.data.friends.size() + 1
          && request.auth.uid in resource.data.friends
          && !(request.auth.uid in request.resource.data.friends);
      }

      function selfRemovedFromFriends() {
        return resource.data.friends.hasAll(request.resource.data.friends)
          && resource.data.friends.size() == request.resource.data.friends.size() + 1
          && request.auth.uid in resource.data.friends
          && !(request.auth.uid in request.resource.data.friends);
      }

      function selfRemovedFromIncomingRequests() {
        return resource.data.incomingRequests.hasAll(request.resource.data.incomingRequests)
          && resource.data.incomingRequests.size() == request.resource.data.incomingRequests.size() + 1
          && request.auth.uid in resource.data.incomingRequests
          && !(request.auth.uid in request.resource.data.incomingRequests);
      }

      function selfRemovedFromOutgoingRequests() {
        return resource.data.outgoingRequests.hasAll(request.resource.data.outgoingRequests)
          && resource.data.outgoingRequests.size() == request.resource.data.outgoingRequests.size() + 1
          && request.auth.uid in resource.data.outgoingRequests
          && !(request.auth.uid in request.resource.data.outgoingRequests);
      }

      function selfRemovedFromBlockedUsers() {
        return resource.data.blockedUsers.hasAll(request.resource.data.blockedUsers)
          && resource.data.blockedUsers.size() == request.resource.data.blockedUsers.size() + 1
          && request.auth.uid in resource.data.blockedUsers
          && !(request.auth.uid in request.resource.data.blockedUsers);
      }

      function safeSelfCleanup() {
        return changedKeys().hasOnly([
          "friends",
          "incomingRequests",
          "outgoingRequests",
          "blockedUsers",
        ])
          && (!changedKeys().hasAny(["friends"]) || selfRemovedFromFriends())
          && (!changedKeys().hasAny(["incomingRequests"]) || selfRemovedFromIncomingRequests())
          && (!changedKeys().hasAny(["outgoingRequests"]) || selfRemovedFromOutgoingRequests())
          && (!changedKeys().hasAny(["blockedUsers"]) || selfRemovedFromBlockedUsers());
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        request.auth.uid == userId || (
          request.auth.uid != userId && (
            safeIncomingUpdate() || safeOutgoingUpdate() || safeOutgoingAccept() || safeFriendRemove() || safeSelfCleanup()
          )
        )
      );
      allow delete: if isSignedIn() && request.auth.uid == userId;

      // Private, device-independent app preferences (theme, notification
      // toggles, app-lock PIN hash, etc.) — never visible to other users.
      match /private/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // A chat can only be read/written by its two participants.
    match /chats/{chatId} {
      // IMPORTANT: `get()` on a chat that hasn't been created yet (e.g. the
      // very first message between two people) still evaluates this rule.
      // When that happens `resource` is null, so `resource.data...` must
      // never be dereferenced without checking for null first — otherwise
      // the rule throws and Firestore reports it as permission-denied,
      // silently blocking brand new conversations from ever being created.
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow update, delete: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        function chatParticipants() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        allow read: if isSignedIn() && request.auth.uid in chatParticipants();
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/chats/$(chatId)).exists()
          && request.auth.uid in chatParticipants();
        // Recipients need to flip a message's status to "delivered"/"read"
        // (used for the double-checkmark receipts) without being able to
        // rewrite its text/sender.
        allow update: if isSignedIn()
          && request.auth.uid in chatParticipants()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]);
        allow delete: if isSignedIn() && request.auth.uid in chatParticipants();
      }
    }

    // Calls (WebRTC signaling) — only the caller/callee involved may read or
    // write the offer/answer/candidates for their call.
    match /calls/{callId} {
      allow read, update, delete: if isSignedIn()
        && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.callerId;

      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
